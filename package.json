{
  "name": "youtube-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "npm run build -- --mode android && cap sync android",
    "android:open": "cap open android",
    "ios:sync": "npm run build -- --mode ios && cap sync ios && node scripts/normalize-ios-paths.mjs",
    "ios:open": "cap open ios",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "backend:start": "supabase start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "backend:stop": "supabase stop",
    "backend:configure": "node scripts/configure-local-supabase.mjs",
    "backend:test": "node scripts/test-supabase.mjs",
    "backend:test:api": "node scripts/test-supabase-http.mjs",
    "predev": "node scripts/ensure-local-env.mjs",
    "test:ui": "node scripts/test-responsive.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "8.3.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@supabase/supabase-js": "2.116.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-player": "^3.3.1",
    "react-router-dom": "^7.6.3",
    "vite-plugin-svgr": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "supabase": "2.117.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
