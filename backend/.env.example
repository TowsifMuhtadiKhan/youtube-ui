# Comma-separated list of allowed frontend origins.
# Example for Netlify + local dev:
# ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Required for creating admin accounts via signup API (role=admin)
ADMIN_SIGNUP_CODE=change-this-secret

# MongoDB (optional, enables persistent database storage for users/playlists/analytics)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# MONGODB_DB_NAME=tomtube

# Optional but recommended for persistence on Vercel:
# Add Vercel KV and these are injected automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
